# Copy to .env and fill in real values. Never commit .env.
# You only need the key for whichever provider(s) you actually assign below --
# e.g. set every *_PROVIDER to "deepseek" and every other key can stay blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Optional
NOTIFIER_WEBHOOK_URL=
MAX_REVIEW_ATTEMPTS=3
MAX_MILESTONES=50
MAX_DIFF_CHARS=100000
MAX_GOAL_CHARS=10000
REQUEST_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO

# Optional Tester agent (runs the project's own tests before the Reviewer
# sees the diff) -- requires Docker to be installed and reachable. Off by
# default; ENABLE_BDD is inert unless ENABLE_TESTER is also true.
ENABLE_TESTER=false
ENABLE_BDD=false
TESTER_TIMEOUT_SECONDS=300
MAX_TEST_OUTPUT_CHARS=20000

# Rewire which provider powers each agent role: "openai", "anthropic",
# "deepseek", "moonshot" (Kimi), "xai" (Grok), or "gemini".
# Defaults below reproduce amao's original wiring (OpenAI plans + executes,
# Anthropic reviews). Leave a *_MODEL blank to use that provider's default model.
PLANNER_PROVIDER=openai
EXECUTOR_PROVIDER=openai
REVIEWER_PROVIDER=anthropic
PLANNER_MODEL=
EXECUTOR_MODEL=
REVIEWER_MODEL=
